# Copy to .env (local) — or add these under Environment Variables in Vercel. Never commit real values.

# News: NewsAPI.org key (NEWS_API also works as the name). Without it the app falls back to GDELT.
# Free Developer plan = 100 requests/day, ~1 month of history, DEVELOPMENT/TESTING ONLY per NewsAPI's terms
# (production plans start at $449/mo). The key stays server-side.
NEWSAPI_KEY=

# AI summaries (Claude Haiku). Paste the FULL key from console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional, local personal use only: fills Reuters/AP (which NewsAPI barely carries) from Google News RSS.
# Google limits that feed to personal, non-commercial use — do NOT set on a public deployment.
# NEWS_SUPPLEMENT=googlenews
